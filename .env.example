# Local development only. Use your hosting secret manager in production.
APP_ORIGIN=http://localhost:3000
APP_USERNAME=scheduler
# Generate independently on your computer: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_PASSWORD=
# Generate another independent 32-byte hex value with the same command.
SESSION_KEY=
PCO_CLIENT_ID=
PCO_CLIENT_SECRET=
# Your church organization ID (not a service ID). Required before connecting.
PCO_ORGANIZATION_ID=
# Include your own contact URL or email, as required by Planning Center.
PCO_USER_AGENT=
CHURCH_NAME=My Church
